{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "startCommand": "python dashboard/main.py",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "APP_ENV": "production",
        "PORT": "8080",
        "HERMES_WEB_MAX_SPEND": "0.00",
        "HERMES_WEB_CACHE_TTL": "300",
        "HERMES_EXECUTION_MODE": "observation"
      }
    }
  }
}
